#!/bin/bash
#SBATCH --job-name=WASIM_exp
#SBATCH --time=00:30:00
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=4G
#SBATCH --output=log/wasim_%j.out

module restore wasim11
WASIM11=$HOME/wasim-eth/src/wasim_mpi_11-00-10-x86-64-pc-linux-euler_intel

srun $WASIM Control/control_simulation.txt > wasim.log
rm wq_* W_V*

